# local (demo secrets allowed) or production (refuses to start with missing,
# placeholder, short or reused secrets). Hosted deployments must use production.
RTI_ENV=local
# Shared secret for HMAC approval tokens. Must match on both services.
RTI_APPROVAL_SECRET=replace-with-a-long-random-value
# Demo operator token for the mock portal console and the CAPTCHA handoff.
RTI_ADMIN_TOKEN=replace-with-a-long-random-value
# Guards the agent's operator surface (approvals, review queue, test results,
# CAPTCHA handoff). Required in production and must differ from the two above.
RTI_OPERATOR_TOKEN=replace-with-a-long-random-value

# Where the SQLite files live.
RTI_DATA_DIR=./data

# Local ports and URLs.
RTI_AGENT_HOST=127.0.0.1
RTI_AGENT_PORT=8000
RTI_PORTAL_HOST=127.0.0.1
RTI_PORTAL_PORT=8001
RTI_PORTAL_URL=http://127.0.0.1:8001
RTI_AGENT_URL=http://127.0.0.1:8000

# auto | playwright | http
RTI_FILING_MODE=auto
RTI_PLAYWRIGHT_TIMEOUT_MS=15000
RTI_ROUTING_THRESHOLD=0.70
# Runs per minute per client; 0 disables the limit. 120 permits a benchmark
# burst while still stopping one client from filling the database.
RTI_RUN_RATE_LIMIT=120
# Durable deadline checks: in-process thread by default. Set 0 to disable.
RTI_WORKER_ENABLED=1
RTI_WORKER_INTERVAL_SECONDS=30

# Outbound alerts for overdue reviews, deadlines, drafted appeals and failed
# checks. Off by default. With no webhook and no SMTP host, the sweep records the
# rows and leaves them pending; it never fails the deadline worker.
RTI_NOTIFY_ENABLED=0
# Any URL that accepts a JSON POST: {kind, run_id, title, text, url, due_at}.
RTI_NOTIFY_WEBHOOK_URL=
RTI_NOTIFY_WEBHOOK_TIMEOUT_SECONDS=10
# Email needs both a recipient and an SMTP host to count as a channel.
RTI_NOTIFY_EMAIL_TO=
RTI_SMTP_HOST=
RTI_SMTP_PORT=587
RTI_SMTP_USER=
RTI_SMTP_PASSWORD=
# Defaults to RTI_SMTP_USER when empty.
RTI_SMTP_FROM=
RTI_SMTP_STARTTLS=1
# How early a review target and a response deadline start alerting.
RTI_NOTIFY_DUE_SOON_HOURS=12
RTI_NOTIFY_DEADLINE_HOURS=72
# Delivery attempts before a notification is marked failed instead of retried.
RTI_NOTIFY_MAX_ATTEMPTS=3

# Optional Claude review layer. Off by default; the deterministic engine is the
# authority for labels, exemptions, fees and the gate.
RTI_USE_LLM=0
# Advisory Section 8(1)(j) classifier. Off by default; it is not a gate. See agent/exemption_model.py.
RTI_EXEMPTION_ADVISORY=0
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
