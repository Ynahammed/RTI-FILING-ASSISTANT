# local (demo secrets allowed) or production (refuses to start with missing,
# placeholder, short or reused secrets). Hosted deployments must use production.
RTI_ENV=local
# Shared secret for HMAC approval tokens. Must match on both services.
RTI_APPROVAL_SECRET=replace-with-a-long-random-value
# Demo operator token for the mock portal console and the CAPTCHA handoff.
RTI_ADMIN_TOKEN=replace-with-a-long-random-value

# Where the SQLite files live.
RTI_DATA_DIR=./data

# Local ports and URLs.
RTI_AGENT_HOST=127.0.0.1
RTI_AGENT_PORT=8000
RTI_PORTAL_HOST=127.0.0.1
RTI_PORTAL_PORT=8001
RTI_PORTAL_URL=http://127.0.0.1:8001
RTI_AGENT_URL=http://127.0.0.1:8000

# auto | playwright | http
RTI_FILING_MODE=auto
RTI_PLAYWRIGHT_TIMEOUT_MS=15000
RTI_ROUTING_THRESHOLD=0.70

# Optional Claude review layer. Off by default; the deterministic engine is the
# authority for labels, exemptions, fees and the gate.
RTI_USE_LLM=0
# Advisory Section 8(1)(j) classifier. Off by default; it is not a gate. See agent/exemption_model.py.
RTI_EXEMPTION_ADVISORY=0
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
